# ---- Copy to .env.local and fill in. NEVER commit real secrets. ----

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Phase 1) — local/CI Postgres, or your Supabase connection string in prod.
# Local Docker compose uses: postgresql://mockcred:mockcred@localhost:5432/mockcred
DATABASE_URL=postgresql://mockcred:mockcred@localhost:5432/mockcred
DB_POOL_MAX=10

# Supabase (prod deployment of the same schema; optional locally)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth (Phase 2): "dev" = self-contained session auth; "clerk" = Clerk (needs keys).
AUTH_PROVIDER=dev
AUTH_SESSION_SECRET=dev-secret-change-me
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Razorpay payments (Phase 4)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Upstash Redis (Phase 3)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend email (Phase 4)
RESEND_API_KEY=

# Sentry (Phase 0)
NEXT_PUBLIC_SENTRY_DSN=

# PostHog analytics (Phase 5)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
